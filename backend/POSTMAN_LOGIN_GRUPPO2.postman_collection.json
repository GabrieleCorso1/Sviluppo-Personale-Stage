            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"access_token\")) { pm.execution.skipRequest(); throw new Error(\"Esegui prima una login riuscita.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json();",
                  "    pm.test(\"Solo i campi concordati\", () => pm.expect(Object.keys(d).sort()).to.eql([\"id\",\"first_name\",\"last_name\",\"email\",\"roles\",\"permissions\"].sort()));",
                  "    pm.test(\"Email dell'utente demo\", () => pm.expect(d.email).to.eql(pm.collectionVariables.get(\"login_email\")));",
                  "    pm.test(\"Ruoli e permessi senza duplicati\", () => {",
                  "        pm.expect(d.roles).to.be.an(\"array\"); pm.expect(d.permissions).to.be.an(\"array\");",
                  "        pm.expect(new Set(d.roles).size).to.eql(d.roles.length);",
                  "        pm.expect(new Set(d.permissions).size).to.eql(d.permissions.length);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
