                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/login",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"password_current\")) { pm.execution.skipRequest(); throw new Error(\"Imposta password_current nelle variabili della collezione con la password attuale del tuo utente demo.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset(\"access_token\");",
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json();",
                  "    pm.test(\"Risposta login\", () => { pm.expect(d.token_type).to.eql(\"Bearer\"); pm.expect(d.access_token).to.be.a(\"string\").and.not.empty; });",
                  "    pm.test(\"Scadenza circa 8 ore\", () => { const delta = (Date.parse(d.expires_at) - Date.now()) / 3600000; pm.expect(delta).to.be.closeTo(8, 0.1); });",
                  "    if (d.access_token) pm.collectionVariables.set(\"access_token\", d.access_token);",
                  "}",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token_before_reset\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 - Forgot password e acquisizione automatica link (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/forgot-password",
            "description": "Se reset_url è null attendere almeno 60 secondi dall'ultima richiesta dello stesso utente. Se manca, verificare le tre opzioni locali. Non apre Angular."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset(\"reset_email\");",
                  "pm.collectionVariables.unset(\"reset_token\");",
                  "if (pm.response.code === 200) {",
                  "    const d = pm.response.json();",
                  "    pm.test(\"Link locale disponibile\", () => pm.expect(d.reset_url).to.be.a(\"string\").and.not.empty);",
                  "    if (typeof d.reset_url === \"string\" && d.reset_url.includes(\"?\")) {",
                  "        const params = {};",
                  "        d.reset_url.split(\"?\")[1].split(\"&\").forEach(part => {",
                  "            const i = part.indexOf(\"=\");",
                  "            if (i >= 0) params[decodeURIComponent(part.slice(0,i))] = decodeURIComponent(part.slice(i+1).replace(/\\+/g,\" \"));",
                  "        });",
                  "        pm.collectionVariables.set(\"reset_email\", params.email || \"\");",
                  "        pm.collectionVariables.set(\"reset_token\", params.token || \"\");",
                  "        pm.test(\"Email e token estratti\", () => { pm.expect(params.email).to.eql(pm.collectionVariables.get(\"login_email\")); pm.expect(params.token).to.be.a(\"string\").and.not.empty; });",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "03 - Reset password (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{reset_email}}\",\n  \"token\": \"{{reset_token}}\",\n  \"password\": \"{{password_new}}\",\n  \"password_confirmation\": \"{{password_new}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/reset-password",
            "description": "Cambia la password. Aggiorna automaticamente password_current soltanto dopo successo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"reset_token\") || !pm.collectionVariables.get(\"reset_email\")) { pm.execution.skipRequest(); throw new Error(\"Esegui prima Forgot password e verifica che restituisca reset_url.\"); }",
                  "if (!pm.collectionVariables.get(\"password_new\") || pm.collectionVariables.get(\"password_new\").length < 8 || pm.collectionVariables.get(\"password_new\") === pm.collectionVariables.get(\"password_current\")) { pm.execution.skipRequest(); throw new Error(\"Imposta password_new: almeno 8 caratteri e diversa dalla password attuale.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Messaggio reset\", () => pm.expect(pm.response.json().message).to.eql(\"Password aggiornata. Accedi con la nuova password.\"));",
                  "    pm.collectionVariables.set(\"password_old\", pm.collectionVariables.get(\"password_current\"));",
                  "    pm.collectionVariables.set(\"password_current\", pm.collectionVariables.get(\"password_new\"));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
