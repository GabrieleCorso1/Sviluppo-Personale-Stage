{
  "info": {
    "name": "Stage - Login e profilo - Essenziali",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Compila mini_admin_password (la password attuale dell’Admin) e, se necessario, mini_base_url. Nessun environment richiesto. Esegui una sola iterazione, in ordine, con Collection Runner; in caso di errore il flusso si ferma. Token e ID sono salvati automaticamente nelle variabili della collection. Non esportare le variabili dopo il run: contengono token. Cambia password solo su un nuovo account dedicato. Non carica né rimuove foto personali. Il recupero può restituire reset_url=null: è corretto fuori dalla modalità demo."
  },
  "variable": [
    {
      "key": "mini_base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "mini_admin_email",
      "value": "mario.rossi@example.com",
      "type": "string"
    },
    {
      "key": "mini_admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "mini_run_optional",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Preparazione automatica",
      "description": "Eseguire in ordine nel Runner. Crea solo un nuovo utente POSTMAN; non modifica utenti esistenti.",
      "item": [
        {
          "name": "01 - Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mini_admin_email}}\",\n  \"password\": \"{{mini_admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.collectionVariables;",
                  "if (!c.get('mini_admin_password')) throw new Error('Compila mini_admin_password nelle variabili della collection.');",
                  "for (const key of ['token','demo_token','admin_id','demo_id','project_id','timesheet_id','allocation_id','sbi_id','revision_id','notification_id','calendar_id','reset_token']) c.unset('mini_'+key);",
                  "c.set('mini_run', Date.now().toString()+'-'+Math.random().toString(36).slice(2,7));",
                  "c.set('mini_today', new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Rome',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()));",
                  "c.set('mini_demo_email','postman.'+c.get('mini_run')+'@example.com');",
                  "c.set('mini_demo_password','Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Token presente\", function () { pm.expect(typeof json.access_token).to.eql('string'); });",
                  "pm.collectionVariables.set('mini_token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Identità e permessi Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/user",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_admin_id', json.id);",
                  "pm.test(\"Account Admin\", function () { pm.expect(json.roles.includes('Admin')).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Opzioni: ruoli, incarichi e avatar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/users/options",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "const role=json.data.roles.find(x=>x.alias==='User'); const assignment=json.data.assignment_roles.find(x=>x.alias==='Sviluppatore Front-end'); if(!role||!assignment||!json.data.default_avatar_id) throw new Error('Eseguire i seeder: mancano le opzioni.');",
                  "pm.collectionVariables.set('mini_role_id', role.id);",
                  "pm.collectionVariables.set('mini_assignment_id', assignment.id);",
                  "pm.collectionVariables.set('mini_avatar_id', json.data.default_avatar_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crea un utente dedicato alla prova",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Prova {{mini_run}}\",\n  \"email\": \"{{mini_demo_email}}\",\n  \"birth_date\": \"1995-01-01\",\n  \"hiring_date\": \"2020-01-01\",\n  \"azure_email\": null,\n  \"company_email\": null,\n  \"gender\": null,\n  \"is_intern\": false,\n  \"isAllocation_visible\": true,\n  \"role_id\": \"{{mini_role_id}}\",\n  \"assignment_role_id\": \"{{mini_assignment_id}}\",\n  \"expertise\": \"junior\",\n  \"filestorage_id\": \"{{mini_avatar_id}}\",\n  \"contract_start_date\": \"2020-01-01\",\n  \"weekly_hours\": 40,\n  \"has_rol\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_demo_id', json.data.id);",
                  "pm.test(\"Password iniziale della demo\", function () { pm.expect(json.initial_password).to.eql(\"Password123!\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
