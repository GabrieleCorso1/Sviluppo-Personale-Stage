            ],
            "url": "{{mini_base_url}}/api/reset-password",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mini_demo_email}}\",\n  \"token\": \"{{mini_reset_token}}\",\n  \"password\": \"PostmanReset123!\",\n  \"password_confirmation\": \"PostmanReset123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('mini_run_optional') !== 'true') pm.execution.skipRequest();",
                  "if(pm.collectionVariables.get('mini_run_optional')==='true'&&!pm.collectionVariables.get('mini_reset_token')) throw new Error('Link demo non disponibile: lascia mini_run_optional=false.');"
                ]
              }
