          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code!==201){pm.execution.setNextRequest(null);throw new Error('Risposta inattesa: controllare il body.');}",
              "const d=pm.response.json().data;pm.collectionVariables.set('sbi_id',d.id);pm.collectionVariables.set('revision_id',d.latest_revision.id);",
              "pm.test('Prima revisione e note autore',()=>{pm.expect(d.latest_revision.revision_number).to.eql(1);pm.expect(d.latest_revision.personal_notes).to.eql('Nota riservata di prova');});"
            ]
          }
        }
      ]
    },
