{
  "info": {
    "name": "Gruppo 2 - SBI - Prove complete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Prove ordinate delle API SBI. Compilare admin_password e recipient_password nelle variabili prima del run. Usa il progetto Portale Clienti e il destinatario dei seeder. Crea ed elimina solo lo SBI di prova. Eseguire una iterazione."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "mario.rossi@example.com",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "recipient_email",
      "value": "luca.verdi@example.com",
      "type": "string"
    },
    {
      "key": "recipient_password",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for(const name of ['admin_password','recipient_password']) { if(!pm.collectionVariables.get(name)){pm.execution.setNextRequest(null);pm.execution.skipRequest();throw new Error('Compilare la variabile '+name+' prima di avviare la collection.');} }",
              "pm.collectionVariables.set('event_date',new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Rome',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()));",
              "for(const name of ['sbi_id','revision_id','second_revision_id','admin_token','recipient_token','project_id','receiver_id']) pm.collectionVariables.unset(name);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code!==200){pm.execution.setNextRequest(null);throw new Error('Risposta inattesa: controllare il body.');}",
              "pm.collectionVariables.set('admin_token',pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Recupera progetto dimostrativo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/projects?is_timesheet=0&search=Portale%20Clienti",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code!==200){pm.execution.setNextRequest(null);throw new Error('Risposta inattesa: controllare il body.');}",
              "const p=pm.response.json().data.find(p=>p.alias==='Portale Clienti'); if(!p){pm.execution.setNextRequest(null);throw new Error('Progetto dei seeder non trovato.');} pm.collectionVariables.set('project_id',p.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Recupera destinatario dimostrativo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users?search={{recipient_email}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code!==200){pm.execution.setNextRequest(null);throw new Error('Risposta inattesa: controllare il body.');}",
              "const u=pm.response.json().data.data.find(u=>u.email===pm.collectionVariables.get('recipient_email')); if(!u){pm.execution.setNextRequest(null);throw new Error('Destinatario non trovato.');} pm.collectionVariables.set('receiver_id',u.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Opzioni SBI",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/sbis/options?project_id={{project_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "if(pm.response.code!==200){pm.execution.setNextRequest(null);throw new Error('Risposta inattesa: controllare il body.');}",
              "pm.test('Destinatario disponibile',()=>pm.expect(pm.response.json().data.receivers.some(u=>u.id===Number(pm.collectionVariables.get('receiver_id')))).to.eql(true));"
            ]
          }
        }
      ]
    },
