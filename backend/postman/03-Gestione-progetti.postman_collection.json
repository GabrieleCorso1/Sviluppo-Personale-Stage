    {
      "name": "02 - Chiusura",
      "description": "",
      "item": [
        {
          "name": "Elimina logicamente il timesheet di prova",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/projects/{{mini_timesheet_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
