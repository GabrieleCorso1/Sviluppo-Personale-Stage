{
  "info": {
    "name": "Stage - Gestione progetti - Essenziali",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Compila mini_admin_password (la password attuale dell’Admin) e, se necessario, mini_base_url. Nessun environment richiesto. Esegui una sola iterazione, in ordine, con Collection Runner; in caso di errore il flusso si ferma. Token e ID sono salvati automaticamente nelle variabili della collection. Non esportare le variabili dopo il run: contengono token. Crea e rimuove solo progetto e timesheet POSTMAN. CSV: verifica la lettura; le prove di upload con file locali rimangono nelle collection complete in archivio."
  },
  "variable": [
    {
      "key": "mini_base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "mini_admin_email",
      "value": "mario.rossi@example.com",
      "type": "string"
    },
    {
      "key": "mini_admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "mini_run_optional",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Preparazione",
      "description": "",
      "item": [
        {
          "name": "01 - Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mini_admin_email}}\",\n  \"password\": \"{{mini_admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.collectionVariables;",
                  "if (!c.get('mini_admin_password')) throw new Error('Compila mini_admin_password nelle variabili della collection.');",
                  "for (const key of ['token','demo_token','admin_id','demo_id','project_id','timesheet_id','allocation_id','sbi_id','revision_id','notification_id','calendar_id','reset_token']) c.unset('mini_'+key);",
                  "c.set('mini_run', Date.now().toString()+'-'+Math.random().toString(36).slice(2,7));",
                  "c.set('mini_today', new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Rome',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()));",
                  "c.set('mini_demo_email','postman.'+c.get('mini_run')+'@example.com');",
                  "c.set('mini_demo_password','Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Token presente\", function () { pm.expect(typeof json.access_token).to.eql('string'); });",
                  "pm.collectionVariables.set('mini_token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Identità e permessi Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/user",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_admin_id', json.id);",
                  "pm.test(\"Account Admin\", function () { pm.expect(json.roles.includes('Admin')).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crea un progetto dedicato alla prova",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/projects",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alias\": \"POSTMAN {{mini_run}}\",\n  \"is_timesheet\": false,\n  \"project_manager_id\": \"{{mini_admin_id}}\",\n  \"start_date\": \"{{mini_today}}\",\n  \"status\": \"in corso\",\n  \"priority\": \"media\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_project_id', json.data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
