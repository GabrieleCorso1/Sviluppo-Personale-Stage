{
  "info": {
    "name": "Stage - Notifiche - Essenziali",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Compila mini_admin_password (la password attuale dell’Admin) e, se necessario, mini_base_url. Nessun environment richiesto. Esegui una sola iterazione, in ordine, con Collection Runner; in caso di errore il flusso si ferma. Token e ID sono salvati automaticamente nelle variabili della collection. Non esportare le variabili dopo il run: contengono token. Genera e legge una notifica riferita a una nuova richiesta. Non marca tutte le notifiche e non elimina notifiche esistenti. Il rifiuto non deve consumare ferie."
  },
  "variable": [
    {
      "key": "mini_base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "mini_admin_email",
      "value": "mario.rossi@example.com",
      "type": "string"
    },
    {
      "key": "mini_admin_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "mini_run_optional",
      "value": "false",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Preparazione automatica",
      "description": "Eseguire in ordine nel Runner. Crea solo un nuovo utente POSTMAN; non modifica utenti esistenti.",
      "item": [
        {
          "name": "01 - Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mini_admin_email}}\",\n  \"password\": \"{{mini_admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.collectionVariables;",
                  "if (!c.get('mini_admin_password')) throw new Error('Compila mini_admin_password nelle variabili della collection.');",
                  "for (const key of ['token','demo_token','admin_id','demo_id','project_id','timesheet_id','allocation_id','sbi_id','revision_id','notification_id','calendar_id','reset_token']) c.unset('mini_'+key);",
                  "c.set('mini_run', Date.now().toString()+'-'+Math.random().toString(36).slice(2,7));",
                  "c.set('mini_today', new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Rome',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()));",
                  "c.set('mini_demo_email','postman.'+c.get('mini_run')+'@example.com');",
                  "c.set('mini_demo_password','Password123!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Token presente\", function () { pm.expect(typeof json.access_token).to.eql('string'); });",
                  "pm.collectionVariables.set('mini_token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Identità e permessi Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/user",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_admin_id', json.id);",
                  "pm.test(\"Account Admin\", function () { pm.expect(json.roles.includes('Admin')).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Opzioni: ruoli, incarichi e avatar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/users/options",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "const role=json.data.roles.find(x=>x.alias==='User'); const assignment=json.data.assignment_roles.find(x=>x.alias==='Sviluppatore Front-end'); if(!role||!assignment||!json.data.default_avatar_id) throw new Error('Eseguire i seeder: mancano le opzioni.');",
                  "pm.collectionVariables.set('mini_role_id', role.id);",
                  "pm.collectionVariables.set('mini_assignment_id', assignment.id);",
                  "pm.collectionVariables.set('mini_avatar_id', json.data.default_avatar_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crea un utente dedicato alla prova",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Prova {{mini_run}}\",\n  \"email\": \"{{mini_demo_email}}\",\n  \"birth_date\": \"1995-01-01\",\n  \"hiring_date\": \"2020-01-01\",\n  \"azure_email\": null,\n  \"company_email\": null,\n  \"gender\": null,\n  \"is_intern\": false,\n  \"isAllocation_visible\": true,\n  \"role_id\": \"{{mini_role_id}}\",\n  \"assignment_role_id\": \"{{mini_assignment_id}}\",\n  \"expertise\": \"junior\",\n  \"filestorage_id\": \"{{mini_avatar_id}}\",\n  \"contract_start_date\": \"2020-01-01\",\n  \"weekly_hours\": 40,\n  \"has_rol\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_demo_id', json.data.id);",
                  "pm.test(\"Password iniziale della demo\", function () { pm.expect(json.initial_password).to.eql(\"Password123!\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Genera una notifica di prova",
      "description": "",
      "item": [
        {
          "name": "Imposta 16 ore di ferie sul solo utente di prova",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/users/{{mini_demo_id}}/leaves",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaves\": [\n    {\n      \"leave_type\": \"ferie\",\n      \"reference_month\": \"{{mini_today}}\",\n      \"remaining_hours\": 16,\n      \"accrued_hours\": 16,\n      \"monthly_accrual\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;"
                ]
              }
            }
          ]
        },
        {
          "name": "Login utente di prova",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{mini_demo_email}}\",\n  \"password\": \"{{mini_demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Token presente\", function () { pm.expect(typeof json.access_token).to.eql('string'); });",
                  "pm.collectionVariables.set('mini_demo_token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Richiedi un giorno lavorativo di ferie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/calendar/requests",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_demo_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Ferie\",\n  \"start_date\": \"{{mini_working_date}}\",\n  \"end_date\": \"{{mini_working_date}}\",\n  \"notes\": \"Richiesta POSTMAN {{mini_run}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d=new Date(pm.collectionVariables.get('mini_today')+'T12:00:00Z'); while([0,6].includes(d.getUTCDay())) d.setUTCDate(d.getUTCDate()+1); pm.collectionVariables.set('mini_working_date',d.toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.collectionVariables.set('mini_calendar_id', json.id);",
                  "pm.test(\"In attesa\", function () { pm.expect(json.status).to.eql(\"pending\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Trova la notifica della sola richiesta creata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/notifications?category=calendar&per_page=100",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "const item=json.data.find(x=>String(x.data.calendar_request_id)===String(pm.collectionVariables.get('mini_calendar_id'))); if(!item) throw new Error('Notifica della richiesta non trovata');",
                  "pm.collectionVariables.set('mini_notification_id', item.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Lettura e decisione",
      "description": "",
      "item": [
        {
          "name": "Dettaglio della notifica",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/notifications/{{mini_notification_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Notifica corretta\", function () { pm.expect(json.id).to.eql(pm.collectionVariables.get('mini_notification_id')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Segna solo questa notifica come letta",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/notifications",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{mini_notification_id}}\"\n  ],\n  \"read\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Una notifica aggiornata\", function () { pm.expect(json.affected).to.eql(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Dettaglio: lettura salvata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/notifications/{{mini_notification_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Data lettura presente\", function () { pm.expect(json.read_at!==null).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Rifiuta la richiesta creata",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/admin/notifications/{{mini_notification_id}}/decision",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Stato salvato\", function () { pm.expect(json.status).to.eql(\"rejected\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Richiesta rifiutata: saldo ancora 16 ore",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/dashboard",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_demo_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;",
                  "pm.test(\"Saldo ferie 16 ore\", function () { pm.expect(json.leave.find(x=>x.type==='ferie').hours).to.eql(16); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Chiusura",
      "description": "",
      "item": [
        {
          "name": "Disabilita solo l’utente creato dalla prova",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/users/{{mini_demo_id}}/disable",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resignation_date\": \"{{mini_today}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error('Richiesta fallita: '+pm.response.text()); }",
                  "const json = /json/i.test(pm.response.headers.get('Content-Type') || '') ? pm.response.json() : null;"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout: revoca il token Admin della prova",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{mini_base_url}}/api/logout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mini_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
